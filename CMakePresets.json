{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-default",
      "displayName": "Host Default",
      "description": "Host build with unit and functional tests",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/host-default",
      "cacheVariables": {
        "BUILD_UNIT_TESTS": "ON",
        "BUILD_FUNCTIONAL_TESTS": "ON",
        "AKREON_PLATFORM": "baremetal",
        "AKREON_USE_NOSYS": "ON"
      }
    },
    {
      "name": "host-functional-only",
      "displayName": "Host Functional Only",
      "description": "Host build without unit tests/Catch2",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/host-functional-only",
      "cacheVariables": {
        "BUILD_UNIT_TESTS": "OFF",
        "BUILD_FUNCTIONAL_TESTS": "ON",
        "AKREON_PLATFORM": "baremetal",
        "AKREON_USE_NOSYS": "ON"
      }
    },
    {
      "name": "stm32-baremetal-nosys",
      "displayName": "STM32 Baremetal Nosys",
      "description": "STM32 cross-compile with nosys syscall stubs",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/stm32-baremetal-nosys",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/arm-none-eabi-stm32.cmake",
        "BUILD_UNIT_TESTS": "OFF",
        "BUILD_FUNCTIONAL_TESTS": "ON",
        "AKREON_PLATFORM": "baremetal",
        "AKREON_USE_NOSYS": "ON"
      }
    },
    {
      "name": "stm32-freertos",
      "displayName": "STM32 FreeRTOS Style",
      "description": "STM32 cross-compile expecting app-provided syscall retargets",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/stm32-freertos",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/arm-none-eabi-stm32.cmake",
        "BUILD_UNIT_TESTS": "OFF",
        "BUILD_FUNCTIONAL_TESTS": "ON",
        "AKREON_PLATFORM": "freertos",
        "AKREON_USE_NOSYS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-default",
      "configurePreset": "host-default"
    },
    {
      "name": "host-functional-only",
      "configurePreset": "host-functional-only"
    },
    {
      "name": "stm32-baremetal-nosys",
      "configurePreset": "stm32-baremetal-nosys"
    },
    {
      "name": "stm32-freertos",
      "configurePreset": "stm32-freertos"
    }
  ]
}
